CUBEJS_DEV_MODE=true
CUBEJS_DB_TYPE=postgres
CUBEJS_DB_HOST=host.docker.internal
CUBEJS_DB_PORT=5433
CUBEJS_DB_NAME=cloudempiere_dev
CUBEJS_DB_USER=cube_readonly
CUBEJS_DB_PASS=changeme
CUBEJS_API_SECRET=changeme-long-random-string
CUBEJS_PG_SQL_PORT=15432
CUBEJS_LOG_LEVEL=info
CUBEJS_DB_SCHEMA=adempiere

# API scopes. This REPLACES the default list rather than extending it, so every
# default scope has to be repeated here. Dropping `sql` silently breaks /v1/sql
# with "API scope is missing: sql", which looks exactly like a planner failure -
# every pre-aggregation check then reports "rollup never matched".
# Defaults are meta,data,graphql,sql; `jobs` is the addition.
CUBEJS_DEFAULT_API_SCOPES=meta,data,graphql,sql,jobs

# Password for the SQL API (DBeaver, Superset, Metabase, psql) on
# CUBEJS_PG_SQL_PORT. The USERNAME carries the tenant - "<ad_client_id>" or
# "<ad_client_id>.<language>", e.g. 1000026.sk_SK - because a BI tool cannot
# send JWT claims and queryRewrite refuses any query without a tenant.
# See checkSqlAuth in cube.js. Anyone holding this password can pick any tenant,
# so keep it on localhost until each tenant has its own credential.
CUBEJS_SQL_PASSWORD=changeme

# Scheduled pre-aggregation refresh. A cold backfill is ~27 yearly partitions
# per fact cube (~189 total). Set false to stop the scheduler competing with
# on-demand builds while testing - and remember to set it back.
CUBEJS_SCHEDULED_REFRESH_TIMER=true
